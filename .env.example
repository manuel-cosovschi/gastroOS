# ============================================
# GastroOS — variables de entorno
# ============================================
# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas secretos reales al repositorio.

# --------------------------------------------
# Supabase (obligatorio)
# --------------------------------------------
# Las dos primeras las encontrás en el dashboard de Supabase:
# Project Settings > API. La URL y la anon key son públicas por diseño
# (viajan al navegador y están protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA: saltea RLS por completo. Hace falta para tres cosas:
#   · `npm run demo:seed`, que crea el usuario de Auth;
#   · el aviso push cuando entra un pedido por la tienda (quien encarga no tiene
#     sesión, y las suscripciones no pueden ser legibles desde el navegador);
#   · la contratación de planes, sólo en el deploy de SOVARE (ver más abajo).
# Sin ella el sistema funciona igual: no hay avisos y no hay contratación.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Migraciones (opcional)
# --------------------------------------------
# Sólo hacen falta para `npm run db:migrate`. Si preferís, pegá los archivos
# de supabase/migrations a mano en el SQL Editor del dashboard y omitilas.
# El token se genera en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --------------------------------------------
# Modo demo
# --------------------------------------------
# Con NEXT_PUBLIC_DEMO_MODE=true la app muestra el cartel de demo y precarga
# el email del usuario demo en el login. Dejalo en false en producción.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_EMAIL=demo@gastroos.app

# Usuario que crean `npm run demo:seed` y `npm run demo:reset`.
# DEMO_PASSWORD no tiene valor por defecto a propósito: elegí uno.
DEMO_EMAIL=demo@gastroos.app
DEMO_PASSWORD=

# --------------------------------------------
# Tienda pública (opcional)
# --------------------------------------------
# Si la base tiene más de un negocio con la tienda habilitada, fijá cuál
# publica este deploy. Con un solo negocio no hace falta.
NEXT_PUBLIC_STOREFRONT_BUSINESS_SLUG=

# --------------------------------------------
# Home comercial
# --------------------------------------------
# Los botones de contacto de la landing sólo aparecen si la variable está
# cargada: así la página nunca muestra un botón que no lleva a ningún lado.

# Link de reserva de reunión. Se saca de Google Calendar: Crear > Página de
# citas, se define duración y disponibilidad (el último turno no puede empezar
# después de las 16 h), y el botón "Compartir" devuelve una URL
# https://calendar.app.google/... Pegala acá.
NEXT_PUBLIC_BOOKING_URL=

# Teléfono en formato internacional, sin + ni espacios. Ej: 5491155550134
NEXT_PUBLIC_WHATSAPP=

NEXT_PUBLIC_CONTACT_EMAIL=

# A dónde lleva "Probar el sistema". Por defecto, el login.
NEXT_PUBLIC_DEMO_URL=/login

# Panel interno de SOVARE. Con esto cargado, el crédito del pie de la home
# ("Un producto de SOVARE") se vuelve el acceso al panel. Dejalo vacío en la
# instalación de un cliente: ahí el crédito es sólo una firma.
NEXT_PUBLIC_SOVARE_PANEL_URL=

# --------------------------------------------
# Contratación de planes (sólo el deploy de SOVARE)
# --------------------------------------------
# Esto no es parte del producto: es la pantalla donde alguien contrata GastroOS
# y paga por transferencia. En la instalación de un cliente no tiene sentido y
# hay que dejarlo vacío — sin estas variables las rutas /contratar y /alta
# devuelven 404 y los botones de los planes no aparecen.
#
# Hace falta, además, SUPABASE_SERVICE_ROLE_KEY de más arriba: quien contrata no
# tiene sesión, y si pudiera escribir la tabla con la anon key (que es pública)
# podría escribir también el veredicto de la verificación y aprobarse el pago.

# Datos de la cuenta que recibe la transferencia. Sin alias, CBU y titular la
# contratación queda deshabilitada: mostrar un dato bancario a medias es peor
# que no mostrar ninguno.
TRANSFER_HOLDER=
TRANSFER_BANK=
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_CUIT=

# Lectura automática del comprobante. Sin la key el comprobante se guarda igual
# y queda en revisión manual: nunca se pierde un pago por esto.
# El modelo tiene que aceptar imágenes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Mail de confirmación (Resend). Sin esto la aprobación funciona igual y el
# panel avisa que el mail quedó pendiente para mandarlo a mano.
# MAIL_FROM tiene que ser una dirección de un dominio verificado en Resend.
# Las mismas dos variables habilitan los mails de pedidos (ver más abajo).
RESEND_API_KEY=
MAIL_FROM=

# URL absoluta del sitio, para los links de los mails. En Vercel se deduce del
# deploy de producción y no hace falta cargarla.
NEXT_PUBLIC_SITE_URL=

# --------------------------------------------
# Notificaciones push del panel
# --------------------------------------------
# Sin estas variables el panel se instala igual en el teléfono, pero la sección
# de notificaciones no aparece: un interruptor que pide permiso y después nunca
# manda nada es peor que no ofrecerlo. Además hace falta
# SUPABASE_SERVICE_ROLE_KEY para que el aviso salga cuando el pedido lo carga
# alguien sin sesión desde la tienda.
#
# Se generan una sola vez con:  npx web-push generate-vapid-keys
# La pública va con NEXT_PUBLIC porque el navegador la necesita para
# suscribirse. La privada nunca sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Una dirección de contacto: es a quien le escribe Google o Apple si hay un
# problema con los envíos.
VAPID_SUBJECT=

# --------------------------------------------
# Mails de pedidos
# --------------------------------------------
# Con RESEND_API_KEY y MAIL_FROM cargadas (arriba), el sistema manda tres
# mails: la confirmación a quien encarga, el aviso al negocio cuando entra un
# pedido por la tienda, y el aviso al cliente cuando el pedido cambia de
# estado. Sin ellas no manda ninguno y la pantalla de confirmación deja de
# prometerlo.
#
# A dónde llega el aviso de pedido nuevo. Si se deja vacío va al email del
# negocio cargado en Configuración, que es lo normal. Cargalo sólo si querés
# que los avisos vayan a otra casilla. Con varios negocios en el mismo deploy
# vale sólo para el de NEXT_PUBLIC_STOREFRONT_BUSINESS_SLUG.
ORDER_NOTIFICATION_EMAIL=

# --------------------------------------------
# Tiendas por subdominio (cuenta compartida)
# --------------------------------------------
# Con varios negocios en la base, la tienda del dominio principal es la que
# nombra esta variable. Sin ella, el primer negocio por orden alfabético se
# queda con la tienda de ejemplo.
NEXT_PUBLIC_STOREFRONT_BUSINESS_SLUG=
# "on" cuando el comodín *.tudominio ya resuelve y tiene certificado. Hasta
# entonces los mails dicen que la tienda se activa en breve, en vez de mostrar
# una dirección que no abre.
TENANT_STORES=
# Sólo si las tiendas cuelgan de otro dominio que el sitio.
NEXT_PUBLIC_ROOT_DOMAIN=
