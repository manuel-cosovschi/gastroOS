# ============================================
# GastroOS — variables de entorno
# ============================================
# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas secretos reales al repositorio.

# --------------------------------------------
# Supabase (obligatorio)
# --------------------------------------------
# Las dos primeras las encontrás en el dashboard de Supabase:
# Project Settings > API. La URL y la anon key son públicas por diseño
# (viajan al navegador y están protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA: saltea RLS por completo. La aplicación NO la usa: sólo hace falta
# para `npm run demo:seed`, que crea el usuario de Auth. No la cargues en el
# hosting — si sembrás con `npm run demo:sql` no la necesitás nunca.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Migraciones (opcional)
# --------------------------------------------
# Sólo hacen falta para `npm run db:migrate`. Si preferís, pegá los archivos
# de supabase/migrations a mano en el SQL Editor del dashboard y omitilas.
# El token se genera en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --------------------------------------------
# Modo demo
# --------------------------------------------
# Con NEXT_PUBLIC_DEMO_MODE=true la app muestra el cartel de demo y precarga
# el email del usuario demo en el login. Dejalo en false en producción.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_EMAIL=demo@gastroos.app

# Usuario que crean `npm run demo:seed` y `npm run demo:reset`.
# DEMO_PASSWORD no tiene valor por defecto a propósito: elegí uno.
DEMO_EMAIL=demo@gastroos.app
DEMO_PASSWORD=

# --------------------------------------------
# Tienda pública (opcional)
# --------------------------------------------
# Si la base tiene más de un negocio con la tienda habilitada, fijá cuál
# publica este deploy. Con un solo negocio no hace falta.
NEXT_PUBLIC_STOREFRONT_BUSINESS_SLUG=

# --------------------------------------------
# Home comercial
# --------------------------------------------
# Los botones de contacto de la landing sólo aparecen si la variable está
# cargada: así la página nunca muestra un botón que no lleva a ningún lado.

# Link de reserva de reunión. Se saca de Google Calendar: Crear > Página de
# citas, se define duración y disponibilidad, y el botón "Compartir" devuelve
# una URL https://calendar.app.google/... Pegala acá.
NEXT_PUBLIC_BOOKING_URL=

# Teléfono en formato internacional, sin + ni espacios. Ej: 5491155550134
NEXT_PUBLIC_WHATSAPP=

NEXT_PUBLIC_CONTACT_EMAIL=

# A dónde lleva "Entrar a la demo". Por defecto, el login.
NEXT_PUBLIC_DEMO_URL=/login
