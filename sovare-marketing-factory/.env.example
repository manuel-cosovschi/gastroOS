# Sovare Marketing Factory — variables de entorno.
# Ninguna tiene valor por defecto. Lo que falta apaga la integración que lo
# necesita (y `smf doctor` / `status` lo muestran); nada falla en silencio.

# --- Base de datos -----------------------------------------------------------
# Postgres (por ejemplo Supabase: Project Settings → Database → Connection string,
# modo "session" o directo). Sin esto se usa PGlite en SMF_DATA_DIR (sólo local).
DATABASE_URL=
# SMF_DATA_DIR=./data
# SMF_OUT_DIR=./out
# Carpeta donde están (o se clonan) los repos de los productos.
# SMF_REPOS_DIR=..

# --- Servicio ----------------------------------------------------------------
SMF_PUBLIC_URL=            # https://factory.tu-dominio (sin barra final)
PORT=8787
SMF_OWNER_KEY=             # 24+ caracteres. Entra al panel y autoriza conexiones de Claude.
SMF_SIGNING_SECRET=        # 32+ caracteres al azar. Cookies y CSRF.
SMF_API_TOKEN=             # 24+ caracteres. Token de máquina (n8n, GitHub Actions, scripts/smf.mjs).
SMF_INGEST_SECRET=         # Secreto HMAC con el que los productos firman POST /api/events.
# SMF_WORKER_CAPS=any,light,render   # qué trabajos toma este ejecutor
# SMF_GITHUB_OWNER=manuel-cosovschi  # para `products_discover`

# --- Meta --------------------------------------------------------------------
META_API_VERSION=v26.0
META_ACCESS_TOKEN=         # Token de usuario del sistema (Business Manager), no uno personal.
META_AD_ACCOUNT_ID=        # sin "act_"
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=    # si la página necesita su propio token para publicar
META_IG_USER_ID=           # cuenta profesional de Instagram vinculada a la página
# Píxel y token de CAPI por producto (o META_PIXEL_ID / META_CAPI_TOKEN para todos).
META_PIXEL_ID_GASTROOS=
META_CAPI_TOKEN_GASTROOS=
META_PIXEL_ID_ALOJAOS=
META_CAPI_TOKEN_ALOJAOS=
# META_TEST_EVENT_CODE=    # manda los eventos CAPI a "Probar eventos" (no cuentan para campañas)

# --- Avisos (al menos uno) ---------------------------------------------------
RESEND_API_KEY=
SMF_MAIL_FROM=             # remitente verificado en Resend
SMF_NOTIFY_EMAIL=          # a quién le llegan los avisos
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMF_NOTIFY_WEBHOOK=        # p. ej. un webhook de n8n

# --- Media pública para Instagram (Supabase Storage) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SMF_MEDIA_BUCKET=smf-media

# --- Lectura de leads y ventas de los productos (rol de SÓLO LECTURA) --------
ALOJAOS_DATABASE_URL=
GASTROOS_DATABASE_URL=

# --- Render ------------------------------------------------------------------
# CHROMIUM_PATH=/usr/bin/chromium
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
